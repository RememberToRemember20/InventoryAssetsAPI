@page "/floors/{FloorId:int}"

<div class="container mt-4 mb-5" style="max-width: 900px;">
    
    <div class="mb-3">
        <a href="/floors" class="btn btn-outline-secondary btn-sm">
            <i class="bi bi-arrow-right me-1"></i> العودة لقائمة الطوابق
        </a>
    </div>

    @if (IsLoading)
    {
        <div class="text-center py-5">
            <div class="spinner-border text-primary" role="status"></div>
            <p class="mt-2 text-muted">جاري تحميل بيانات الطابق والغرف...</p>
        </div>
    }
    else if (Floor == null)
    {
        <div class="alert alert-danger text-center">
            لم يتم العثور على الطابق المطلوب.
        </div>
    }
    else
    {
        <div class="d-flex justify-content-between align-items-center mb-4 pb-2 border-bottom">
            <div>
                <h3 class="fw-bold mb-1"><i class="bi bi-building text-primary me-2"></i>@Floor.Name</h3>
                <span class="text-muted">إجمالي الغرف: @Floor.Rooms.Count</span>
            </div>
            <a href="/add-room" class="btn btn-success">
                <i class="bi bi-plus-circle me-1"></i> إضافة غرفة لهذا الطابق
            </a>
        </div>

        @if (Floor.Rooms.Count == 0)
        {
            <div class="alert alert-info text-center py-4">
                لا توجد غرف مسجلة في هذا الطابق حتى الآن.
            </div>
        }
        else
        {
           <div class="row row-cols-1 row-cols-md-2 g-3">
                @foreach (var room in Floor.Rooms)
                {
                    <div class="col">
                        <div class="card shadow-sm h-100 border-start border-4 border-primary">
                            <div class="card-body d-flex justify-content-between align-items-center">
                                <div>
                                    <h5 class="card-title fw-bold mb-1">@room.Name</h5>
                                    <small class="text-muted">معرف الغرفة: #@room.Id</small>
                                </div>
                                <div class="text-end">
                                    <!-- إضافة رابط ينقل لصفحة أصول هذه الغرفة وإضافة أصل جديد -->
                                    <a href="/rooms/@room.Id/add-asset" class="btn btn-sm btn-outline-primary me-1" title="إضافة أصل">
                                        <i class="bi bi-plus-lg"></i>
                                    </a>
                                    <a href="/rooms/@room.Id/assets" class="btn btn-sm btn-link text-decoration-none p-0">
                                        عرض الأصول ←
                                    </a>
                                </div>
                            </div>
                        </div>
                    </div>
                }
            </div>
        }
    }
</div>